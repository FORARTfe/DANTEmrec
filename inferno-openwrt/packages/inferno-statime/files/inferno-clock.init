#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
START=90
STOP=11
USE_PROCD=1

start_service() {
	local enabled network device address log_level
	config_load inferno-clock
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	. /usr/lib/inferno/common.sh
	. /lib/functions/network.sh
	config_get network main network audio
	config_get log_level main log_level info
	inferno_network "$network" || { inferno_fail 'Invalid clock logical network'; return 1; }
	case "$log_level" in error|warn|info|debug|trace) ;; *) inferno_fail 'Invalid clock log level'; return 1;; esac
	network_get_device device "$network" && network_get_ipaddr address "$network" || {
		inferno_fail "Network $network is not ready with IPv4"; return 1;
	}
	inferno_device "$device" || { inferno_fail 'Invalid clock device name'; return 1; }
	inferno_runtime_dir /var/run/inferno-clock root:inferno 2770 || return 1
	inferno_runtime_dir /var/run/inferno-statime root:root 0700 || return 1
	umask 077
	cat > /var/run/inferno-statime/statime.toml.new <<CONFIG
loglevel = "$log_level"
sdo-id = 0
domain = 0
slave-only = true
priority1 = 251
virtual-system-clock = true
virtual-system-clock-base = "monotonic_raw"
usrvclock-export = true
usrvclock-path = "/var/run/inferno-clock/clock.sock"

[[port]]
interface = "$device"
network-mode = "ipv4"
hardware-clock = "none"
protocol-version = "PTPv1"
CONFIG
	mv /var/run/inferno-statime/statime.toml.new /var/run/inferno-statime/statime.toml || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/inferno-clock-run -c /var/run/inferno-statime/statime.toml
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0" nofile="256 256"
	procd_set_param file /etc/config/inferno-clock /var/run/inferno-statime/statime.toml
	procd_set_param netdev "$device"
	procd_close_instance
}

service_triggers() {
	local network
	config_load inferno-clock
	config_get network main network audio
	procd_add_reload_trigger inferno-clock
	procd_add_interface_trigger 'interface.*' "$network" /etc/init.d/inferno-clock restart
}
