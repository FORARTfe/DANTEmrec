config inferno 'main'
	option enabled '0'
	option network 'audio'
	option name 'Inferno-OpenWrt'
	option channels '2'
	option sample_rate '48000'
	# Both upstream RX/TX latency fields are set to this value.
	option latency_ns '10000000'
	option rx_buffer_samples '65536'
	option block_frames '4096'
	option queue_blocks '16'
	option output_timeout_ms '5000'
	# /dev/null is a diagnostic/discard sink; select the FIFO to consume audio.
	option output '/dev/null'
	option state_dir '/var/run/inferno/state'
	option log_level 'info'
	# Opt-in only: permits the upstream RX thread to request priority 80.
	option realtime '0'
