#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled network device address name channels sample_rate latency_ns rx_buffer_samples
	local block_frames queue_blocks output_timeout_ms output state_dir log_level realtime
	config_load inferno
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	. /usr/lib/inferno/common.sh
	. /lib/functions/network.sh
	config_get network main network audio
	config_get name main name Inferno-OpenWrt
	config_get channels main channels 2
	config_get sample_rate main sample_rate 48000
	config_get latency_ns main latency_ns 10000000
	config_get rx_buffer_samples main rx_buffer_samples 65536
	config_get block_frames main block_frames 4096
	config_get queue_blocks main queue_blocks 16
	config_get output_timeout_ms main output_timeout_ms 5000
	config_get output main output /dev/null
	config_get state_dir main state_dir /var/run/inferno/state
	config_get log_level main log_level info
	config_get_bool realtime main realtime 0
	inferno_network "$network" && inferno_name "$name" &&
		inferno_uint "$channels" 1 32 && inferno_uint "$latency_ns" 1000000 40000000 &&
		inferno_uint "$block_frames" 256 65536 && inferno_uint "$queue_blocks" 2 64 &&
		inferno_uint "$output_timeout_ms" 100 30000 || { inferno_fail 'Invalid inferno configuration'; return 1; }
	case "$sample_rate" in 44100|48000|88200|96000|176400|192000) ;; *) inferno_fail 'Invalid sample rate'; return 1;; esac
	case "$rx_buffer_samples" in 65536|131072|262144|524288) ;; *) inferno_fail 'Invalid receive buffer'; return 1;; esac
	case "$log_level" in error|warn|info|debug|trace) ;; *) inferno_fail 'Invalid log level'; return 1;; esac
	case "$output" in /*) ;; *) inferno_fail 'Output must be an absolute path'; return 1;; esac
	case "$state_dir" in /*) ;; *) inferno_fail 'State directory must be absolute'; return 1;; esac
	[ "$((channels * block_frames * queue_blocks * 4))" -le 33554432 ] || {
		inferno_fail 'Output buffer pool exceeds 32 MiB'; return 1;
	}
	network_get_device device "$network" && network_get_ipaddr address "$network" || {
		inferno_fail "Network $network is not ready with IPv4"; return 1;
	}
	inferno_device "$device" || { inferno_fail 'Invalid device name'; return 1; }
	inferno_runtime_dir /var/run/inferno inferno:inferno 0700 || return 1
	if [ "$state_dir" = /var/run/inferno/state ]; then
		inferno_runtime_dir "$state_dir" inferno:inferno 0700 || return 1
	else
		[ -d "$state_dir" ] && [ ! -L "$state_dir" ] || {
			inferno_fail 'Create a persistent state directory owned by inferno before using it'; return 1;
		}
	fi
	if [ "$output" = /var/run/inferno/audio.pcm ]; then
		[ ! -L "$output" ] || { inferno_fail 'Refusing symlink output'; return 1; }
		if [ ! -e "$output" ]; then
			mkfifo -m 0600 "$output" || return 1
		fi
		[ -p "$output" ] || { inferno_fail 'Expected an audio FIFO'; return 1; }
		chown inferno:inferno "$output" || return 1
		chmod 0600 "$output" || return 1
	fi
	procd_open_instance
	procd_set_param command /usr/bin/inferno2pipe --channels-count "$channels" --output "$output" \
		--block-frames "$block_frames" --queue-blocks "$queue_blocks" --output-timeout-ms "$output_timeout_ms"
	procd_set_param user inferno
	procd_set_param group inferno
	procd_set_param env "INFERNO_BIND_IP=$device" "INFERNO_NAME=$name" \
		"INFERNO_SAMPLE_RATE=$sample_rate" "INFERNO_RX_LATENCY_NS=$latency_ns" \
		"INFERNO_TX_LATENCY_NS=$latency_ns" "INFERNO_RX_BUFFER_SAMPLES=$rx_buffer_samples" \
		"INFERNO_CLOCK_PATH=/var/run/inferno-clock/clock.sock" "INFERNO_STATE_DIR=$state_dir" \
		"HOME=/var/run/inferno" "RUST_LOG=$log_level" "RUST_BACKTRACE=0"
	procd_set_param limits core="0 0" nofile="256 256"
	if [ "$realtime" = 1 ]; then
		procd_append_param limits rtprio="80 80" rttime="2000000 2000000"
	else
		procd_append_param limits rtprio="0 0"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/inferno
	procd_set_param netdev "$device"
	procd_close_instance
}

service_triggers() {
	local network
	config_load inferno
	config_get network main network audio
	procd_add_reload_trigger inferno
	procd_add_interface_trigger 'interface.*' "$network" /etc/init.d/inferno restart
}
